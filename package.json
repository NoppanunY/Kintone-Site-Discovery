{
  "name": "kintone-site-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-desktop/desktop/main.cjs",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "desktop:dev": "pnpm desktop:compile && node desktop/scripts/dev.mjs",
    "desktop:build": "pnpm build && pnpm desktop:compile",
    "desktop:start": "pnpm desktop:build && node desktop/scripts/start.mjs"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^43.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
