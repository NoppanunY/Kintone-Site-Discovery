{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "../dist-desktop",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node", "electron"],
    "declaration": true,
    "sourceMap": true
  },
  "include": ["./**/*.cts", "../src/platform/bridgeTypes.ts", "../packages/core/src/**/*.ts"]
}
